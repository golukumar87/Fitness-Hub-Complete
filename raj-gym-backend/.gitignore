# ============================================
# Raj Gym Backend - .gitignore
# ============================================

# === Node.js / Dependencies ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Environment Variables ===
.env
.env.local
.env.*.local

# === Firebase Admin Config (Sensitive Credentials) ===
firebaseAdminConfig.json
*-service-account.json
*-firebase-key.json
*.private-key.json

# === Logs ===
logs/
*.log
npm-install-out.txt

# === OS Generated Files ===
.DS_Store
Thumbs.db
Desktop.ini

# === IDE / Editor Files ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Temp / Cache ===
tmp/
temp/
*.tmp

# === Coverage ===
coverage/

# === Package Lock (optional) ===
# Uncomment if you want to ignore package-lock.json
# package-lock.json

